{
  "name": "portable-ui",
  "version": "0.1.0",
  "description": "React components for work boards, chat, charts and maps, themed with the Portable palette.",
  "keywords": [
    "react",
    "ui-library",
    "components",
    "kanban",
    "chat",
    "charts",
    "maps",
    "design-system",
    "dark-theme",
    "bun",
    "typescript"
  ],
  "homepage": "https://github.com/timfewi/portable-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timfewi/portable-ui.git"
  },
  "bugs": {
    "url": "https://github.com/timfewi/portable-ui/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/portable-ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun --hot --port 5173 ./playground/index.html",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fmt": "just fmt",
    "fmt:check": "just fmt-check",
    "biome": "bun scripts/biome.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@biomejs/cli-linux-x64-musl": "2.6.8",
    "@biomejs/cli-linux-arm64-musl": "2.6.8"
  }
}
